import pandas as pd
import numpy as np

datos = {
    "nombre_real": ["Estefania Grijalva", "Gissella Enriquez", "Juan Perez", "Maria Lopez"],
    "edad": [22, 21, 45, 34],
    "minutos_vistos": [120, 450, 50, 300],
    "plan": ["Premium", "Estándar", "Básico", "Premium"]
}
df = pd.DataFrame(datos)
print("--- DATOS ORIGINALES (Privacidad vulnerable) ---")
display(df)

df["id_anonimo"] = pd.factorize(df["nombre_real"])[0] + 1
df = df.drop(columns=["nombre_real"]) 

print("\n--- DATOS ANONIMIZADOS (GDPR/CCPA Compliant) ---")
display(df)

epsilon = 1.0 
escala = 1.0 / epsilon
ruido = np.random.laplace(0, escala, len(df))

df["minutos_vistos_protegidos"] = df["minutos_vistos"] + ruido

print("\n--- DATOS CON PRIVACIDAD DIFERENCIAL (Métricas protegidas) ---")
display(df[["id_anonimo", "minutos_vistos", "minutos_vistos_protegidos"]])
