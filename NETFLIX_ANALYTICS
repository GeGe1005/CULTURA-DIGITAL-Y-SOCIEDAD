        "## 4. Funciones de limpieza y transformación\n",
        "\n",
        "Se convierten los campos numéricos antes de filtrar nulos. La duración igual a cero **no elimina el registro**: se conserva y su tasa de finalización queda como `NaN`, porque no es posible dividir entre cero."
      ],
      "id": "yRKRBJXiHW6u"
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {
        "id": "5otWOSpCHW6v"
      },
      "outputs": [],
      "source": [
        "NIVEL_PLAN = {\"Básico\": 1, \"Estándar\": 2, \"Premium\": 3}\n",
        "\n",
        "def limpiar_datos(datos):\n",
        "    \"\"\"Limpia tipos y filtra registros incompletos y usuarios menores de 18.\n",
        "\n",
        "    Conserva eventos con duración cero para que la tasa de finalización\n",
        "    pueda quedar indefinida (NaN), sin provocar división por cero.\n",
        "    \"\"\"\n",
        "    df_limpio = datos.copy()\n",
        "\n",
        "    columnas_numericas = [\n",
        "        \"edad\", \"minutos_vistos\", \"duracion_contenido_min\"\n",
        "    ]\n",
        "    for columna in columnas_numericas:\n",
        "        df_limpio[columna] = pd.to_numeric(\n",
        "            df_limpio[columna], errors=\"coerce\"\n",
        "        )\n",
        "\n",
        "    columnas_obligatorias = [\n",
        "        \"usuario_id\", \"edad\", \"genero\", \"titulo\", \"minutos_vistos\",\n",
        "        \"duracion_contenido_min\", \"plan\", \"dispositivo\", \"pais\",\n",
        "        \"fecha_visualizacion\"\n",
        "    ]\n",
        "    df_limpio = df_limpio.dropna(subset=columnas_obligatorias)\n",
        "    df_limpio = df_limpio.loc[df_limpio[\"edad\"] >= 18].copy()\n",
        "\n",
        "    if (df_limpio[\"duracion_contenido_min\"] < 0).any():\n",
        "        raise ValueError(\"Hay duraciones negativas en el conjunto de datos.\")\n",
        "    if (df_limpio[\"minutos_vistos\"] < 0).any():\n",
        "        raise ValueError(\"Hay minutos vistos negativos en el conjunto de datos.\")\n",
        "\n",
        "    return df_limpio\n",
        "\n",
        "\n",
        "def agregar_nivel_plan(datos):\n",
        "    \"\"\"Añade nivel_plan: Básico=1, Estándar=2 y Premium=3.\"\"\"\n",
        "    resultado = datos.copy()\n",
        "    resultado[\"nivel_plan\"] = resultado[\"plan\"].map(NIVEL_PLAN)\n",
        "    return resultado\n",
        "\n",
        "\n",
        "def anonimizar_usuarios(datos):\n",
        "    \"\"\"Sustituye los identificadores originales por códigos enteros locales.\"\"\"\n",
        "    resultado = datos.copy()\n",
        "    resultado[\"usuario_id\"] = (\n",
        "        pd.factorize(resultado[\"usuario_id\"], sort=True)[0] + 1\n",
        "    )\n",
        "    return resultado"
      ],
