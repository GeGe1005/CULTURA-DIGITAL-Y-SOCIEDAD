        "## 5. Métricas y resumen\n",
        "\n",
        "La tasa se expresa como porcentaje (0–100). `alta_finalizacion` significa una tasa igual o superior al 80 %. Este umbral es un criterio analítico elegido para el ejercicio, no un dato proporcionado por Netflix."
      ],
      "id": "dqwmjdQVHW6x"
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {
        "id": "9FGKLtl2HW6z"
      },
      "outputs": [],
      "source": [
        "def calcular_tasa_finalizacion(minutos_vistos, duracion):\n",
        "    \"\"\"Calcula la finalización porcentual; devuelve NaN si la duración es 0.\n",
        "\n",
        "    El resultado se limita al intervalo 0–100.\n",
        "    \"\"\"\n",
        "    tasa = (minutos_vistos / duracion.replace(0, np.nan)) * 100\n",
        "    return tasa.clip(lower=0, upper=100)\n",
        "\n",
        "\n",
        "def agregar_metricas(datos, umbral=80):\n",
        "    \"\"\"Agrega tasa_finalizacion y la bandera alta_finalizacion.\"\"\"\n",
        "    resultado = datos.copy()\n",
        "    resultado[\"tasa_finalizacion\"] = calcular_tasa_finalizacion(\n",
        "        resultado[\"minutos_vistos\"],\n",
        "        resultado[\"duracion_contenido_min\"]\n",
        "    )\n",
        "    resultado[\"alta_finalizacion\"] = (\n",
        "        resultado[\"tasa_finalizacion\"].ge(umbral).fillna(False)\n",
        "    )\n",
        "    return resultado\n",
        "\n",
        "\n",
        "def crear_resumen(datos):\n",
        "    \"\"\"Resume visualizaciones, minutos y finalización media por título.\"\"\"\n",
        "    return (\n",
        "        datos.groupby(\"titulo\", as_index=False)\n",
        "        .agg(\n",
        "            visualizaciones=(\"titulo\", \"size\"),\n",
        "            minutos_totales=(\"minutos_vistos\", \"sum\"),\n",
        "            finalizacion_media=(\"tasa_finalizacion\", \"mean\")\n",
        "        )\n",
        "        .sort_values(\"minutos_totales\", ascending=False)\n",
        "    )"
      ],
